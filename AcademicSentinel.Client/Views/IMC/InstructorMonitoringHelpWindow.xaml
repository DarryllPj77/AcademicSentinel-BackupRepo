<Window x:Class="AcademicSentinel.Client.Views.IMC.InstructorMonitoringHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Instructor Monitoring Console — Help"
        Height="780" Width="1320"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        FontFamily="{materialDesign:MaterialDesignFont}"
        TextElement.Foreground="#1B1B1B"
        TextElement.FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="FEUGreenBrush"     Color="#1B5E20"/>
        <SolidColorBrush x:Key="FEUGreenDarkBrush" Color="#0D3B12"/>
        <SolidColorBrush x:Key="FEUGoldBrush"      Color="#FFB300"/>
        <SolidColorBrush x:Key="DangerRedBrush"    Color="#D32F2F"/>
        <SolidColorBrush x:Key="MutedBrush"        Color="#616161"/>
        <SolidColorBrush x:Key="CardBorderBrush"   Color="#E0E0E0"/>

        <!-- Every clickable region wraps its content in a Border that
             uses this style. The transparent default border becomes
             gold on hover and gold-thick when selected via the
             attached "IsSelected" tag set in code-behind. -->
        <Style x:Key="HelpRegion" TargetType="Border">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FFB300"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>

        <Style x:Key="SectionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1B1B1B"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="19"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================
             LEFT COLUMN — visual replica of the Instructor Monitoring
             Console. Each labelled region is wrapped in a Border with
             the HelpRegion style and a Tag identifying the region key.
             ============================================================ -->
        <Grid Grid.Column="0" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- Sub-header / intro -->
            <StackPanel Grid.Row="0" Margin="2,0,2,10">
                <TextBlock Text="Interactive Tutorial"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource FEUGreenBrush}"/>
                <TextBlock Text="Click any highlighted section in the replica below to learn what it does."
                           FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Replica header bar (green) -->
            <Border Grid.Row="1" Style="{StaticResource HelpRegion}"
                    Tag="header" MouseLeftButtonDown="Region_Click"
                    Background="{StaticResource FEUGreenBrush}"
                    Padding="20,14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="SchoolOutline" Width="26" Height="26"
                                                 Foreground="White" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Instructor Monitoring Console"
                                       FontSize="15" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="(replica — for tutorial purposes)" FontSize="10"
                                       Foreground="#A5D6A7"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{StaticResource DangerRedBrush}"
                            CornerRadius="6" Padding="18,8" Margin="0,0,10,0">
                        <TextBlock Text="End Session" FontWeight="SemiBold" Foreground="White"/>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Right" Margin="0,0,10,0">
                            <TextBlock Text="Prof. Sample" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Right"/>
                            <TextBlock Text="FEU Institute of Technology" FontSize="9" Foreground="#A5D6A7" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <Border Width="32" Height="32" CornerRadius="16" Background="#7C4DFF">
                            <materialDesign:PackIcon Kind="AccountCircle" Width="22" Height="22"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body: 3-column mock layout -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Start button + Participants panel -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">

                    <Border Style="{StaticResource HelpRegion}"
                            Tag="start" MouseLeftButtonDown="Region_Click"
                            Background="{StaticResource FEUGreenBrush}"
                            Padding="16,14" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="Play" Width="18" Height="18" Foreground="White"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Start Session Monitoring" FontWeight="SemiBold" Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HelpRegion}"
                            Tag="participants" MouseLeftButtonDown="Region_Click"
                            Background="White">
                        <StackPanel>
                            <Border Background="{StaticResource FEUGreenBrush}" CornerRadius="9,9,0,0" Padding="14,10">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountMultiple" Width="16" Height="16"
                                                             Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Participants" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                    <Border Background="{StaticResource FEUGoldBrush}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                        <TextBlock Text="2 / 3" FontSize="11" FontWeight="Bold" Foreground="#0D3B12"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="12">
                                <Border Background="#F5F5F5" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Fill="#4CAF50" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Student A — Connected" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F5F5F5" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Fill="#FFB300" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Student B — Idle" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F5F5F5" CornerRadius="6" Padding="10,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Fill="#9E9E9E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Student C — Awaiting" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- CENTER: Risk dashboard -->
                <Border Grid.Column="1" Style="{StaticResource HelpRegion}"
                        Tag="risk" MouseLeftButtonDown="Region_Click"
                        Background="White" Margin="0,0,12,0">
                    <StackPanel>
                        <Border Background="{StaticResource FEUGreenBrush}" CornerRadius="9,9,0,0" Padding="14,10">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountOutline" Width="16" Height="16" Foreground="White"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Selected Student — Risk Dashboard" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Grid Margin="20" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,4,0,16">
                                <TextBlock Text="Student A" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="WAITING" FontSize="10" FontWeight="Bold" Foreground="#9E9E9E"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="RISK LEVEL" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="SAFE" FontSize="42" FontWeight="Bold" Foreground="#1B5E20"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                <TextBlock Text="0 violations · severity score 0"
                                           FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- RIGHT: Global Log Feed + Environment Profile -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource HelpRegion}"
                            Tag="log" MouseLeftButtonDown="Region_Click"
                            Background="White" Margin="0,0,0,12">
                        <StackPanel>
                            <Border Background="{StaticResource FEUGreenBrush}" CornerRadius="9,9,0,0" Padding="14,10">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FormatListBulleted" Width="16" Height="16"
                                                             Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Global Log Feed" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="12">
                                <TextBlock Text="• 10:31:04  Student A joined session" FontSize="11" Margin="0,2"/>
                                <TextBlock Text="• 10:31:18  Student B joined session" FontSize="11" Margin="0,2"/>
                                <TextBlock Text="• 10:33:42  Student B — focus lost" FontSize="11" Foreground="#E65100" Margin="0,2"/>
                                <TextBlock Text="• 10:34:11  Student B — focus regained" FontSize="11" Margin="0,2"/>
                                <TextBlock Text="• 10:35:00  Hardware OK (3/3 students)" FontSize="11" Margin="0,2"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource HelpRegion}"
                            Tag="env" MouseLeftButtonDown="Region_Click"
                            Background="White">
                        <StackPanel Margin="14,12">
                            <TextBlock Text="ENVIRONMENT PROFILE" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="• Focus detection      ON"   FontSize="11" Margin="0,1"/>
                            <TextBlock Text="• Idle detection       ON"   FontSize="11" Margin="0,1"/>
                            <TextBlock Text="• Process detection    ON"   FontSize="11" Margin="0,1"/>
                            <TextBlock Text="• Clipboard monitoring ON"   FontSize="11" Margin="0,1"/>
                            <TextBlock Text="• Strict mode          OFF"  FontSize="11" Margin="0,1"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="3" Background="#E8F5E9" Margin="0,12,0,0" Padding="12,6" CornerRadius="6">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="TimerOutline" Width="14" Height="14"
                                             Foreground="{StaticResource FEUGreenDarkBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Status bar — session timer + connection state appear here on the real console."
                               FontSize="11" Foreground="{StaticResource FEUGreenDarkBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================
             RIGHT COLUMN — explanation panel.
             Default state shows guidance. Region clicks update the
             three sections below from the Region_Click handler.
             ============================================================ -->
        <Border Grid.Column="1" Background="White"
                Margin="0,20,20,20" Padding="22"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="HELP"
                               FontSize="10" FontWeight="Bold" Foreground="{StaticResource FEUGoldBrush}"/>
                    <TextBlock x:Name="TxtRegionTitle"
                               Text="Click a section"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource FEUGreenBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock x:Name="TxtIntro"
                                   Style="{StaticResource SectionText}"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,8,0,0"
                                   Text="The Instructor Monitoring Console is what you use during a live exam to watch students, react to violations, and end the session cleanly. Click any highlighted area on the left to learn how that piece fits in."/>

                        <TextBlock x:Name="LblPurpose"   Style="{StaticResource SectionLabel}" Text="PURPOSE"      Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtPurpose"   Style="{StaticResource SectionText}" Visibility="Collapsed"/>

                        <TextBlock x:Name="LblTypical"   Style="{StaticResource SectionLabel}" Text="TYPICAL USE"  Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtTypicalUse" Style="{StaticResource SectionText}" Visibility="Collapsed"/>

                        <TextBlock x:Name="LblExample"   Style="{StaticResource SectionLabel}" Text="EXAMPLE"      Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtExample"   Style="{StaticResource SectionText}" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#FFF8E1" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="InformationOutline" Width="16" Height="16"
                                                 Foreground="#F57F17" VerticalAlignment="Top" Margin="0,1,8,0"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#5D4037">
                            <Run Text="This is a safe replica."/>
                            <LineBreak/>
                            <Run Text="Clicking here never starts, pauses, or ends a real monitoring session."/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Floating Close button (top-right) -->
        <Button Grid.Column="1" Content="Close"
                Click="BtnClose_Click"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,32,32,0"
                Padding="14,6"
                Cursor="Hand"
                Background="{StaticResource FEUGreenBrush}" Foreground="White"
                FontWeight="SemiBold" BorderThickness="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="cb" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="cb" Property="Background" Value="#2E7D32"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
