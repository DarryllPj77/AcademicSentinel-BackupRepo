<Window x:Class="AcademicSentinel.Client.Views.IMC.InstructorMonitoringHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Live Session Monitoring — Help"
        Height="820" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        FontFamily="{materialDesign:MaterialDesignFont}"
        TextElement.Foreground="#1B1B1B"
        TextElement.FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="FEUGreenBrush"      Color="#1B5E20"/>
        <SolidColorBrush x:Key="FEUGreenLightBrush" Color="#2E7D32"/>
        <SolidColorBrush x:Key="FEUGreenDarkBrush"  Color="#0D3B12"/>
        <SolidColorBrush x:Key="FEUGoldBrush"       Color="#FFB300"/>
        <SolidColorBrush x:Key="DangerRedBrush"     Color="#D32F2F"/>
        <SolidColorBrush x:Key="FEUSubTextBrush"    Color="#616161"/>

        <!-- Every clickable region in the replica wraps its content
             in a Border with this style. Transparent default border
             goes gold on hover so the user knows the area is
             interactive. -->
        <Style x:Key="HelpRegion" TargetType="Border">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FFB300"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- Top breadcrumb / tutorial banner -->
        <Grid Grid.Row="0" Margin="24,14,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Live Session Monitoring — Tutorial"
                       FontSize="12" Foreground="{StaticResource FEUSubTextBrush}"
                       VerticalAlignment="Center"/>
            <Border Grid.Column="1" Background="#FFF8E1" BorderBrush="#FFB300" BorderThickness="1"
                    CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="InformationOutline" Width="12" Height="12"
                                             Foreground="#F57F17" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="Click any highlighted area to learn about it"
                               FontSize="10" Foreground="#5D4037" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Green header bar (REGION: header) -->
        <Border Grid.Row="1" Style="{StaticResource HelpRegion}"
                Tag="header" MouseLeftButtonDown="Region_Click"
                Background="{StaticResource FEUGreenBrush}"
                Margin="20,0,20,0" Padding="24,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" Color="Black"/>
            </Border.Effect>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="SchoolOutline" Width="32" Height="32"
                                             Foreground="White" Margin="0,0,14,0"/>
                    <StackPanel>
                        <TextBlock Text="Instructor Monitoring Console"
                                   FontSize="17" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="(replica — for tutorial purposes)" FontSize="11"
                                   Foreground="#A5D6A7"/>
                    </StackPanel>
                </StackPanel>

                <!-- "End Session" mock — plain Border, NOT a Button -->
                <Border Grid.Column="2" Background="{StaticResource DangerRedBrush}"
                        CornerRadius="6" Padding="22,10" Margin="0,0,16,0">
                    <TextBlock Text="End Session" FontWeight="SemiBold" Foreground="White"/>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Right" Margin="0,0,12,0">
                        <TextBlock Text="Prof. Sample"
                                   FontWeight="Bold" FontSize="14" Foreground="White"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Text="FEU Institute of Technology"
                                   FontSize="10" Foreground="#A5D6A7"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Border Width="40" Height="40" CornerRadius="20" Background="#7C4DFF">
                        <materialDesign:PackIcon Kind="AccountCircle" Width="26" Height="26"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: sidebar + log feed pane -->
        <Grid Grid.Row="2" Margin="20,16,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===================================================
                 LEFT SIDEBAR
                 =================================================== -->
            <StackPanel Grid.Column="0">

                <!-- REGION: countdown -->
                <Border Style="{StaticResource HelpRegion}"
                        Tag="countdown" MouseLeftButtonDown="Region_Click"
                        Background="White" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="NOT ACTIVE" FontSize="13" FontWeight="Bold"
                                   Foreground="#9E9E9E" HorizontalAlignment="Center"/>
                        <Border Background="#F0F2F5" CornerRadius="14" Padding="14,4" Margin="0,8,0,0">
                            <TextBlock Text="No Active Countdown" FontSize="11" Foreground="#616161"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- REGION: viewParticipants -->
                <Border Style="{StaticResource HelpRegion}"
                        Tag="viewParticipants" MouseLeftButtonDown="Region_Click"
                        Background="White" BorderThickness="3"
                        Margin="0,0,0,12">
                    <Border Background="White" CornerRadius="9" Padding="14,10" BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="AccountMultipleOutline" Width="18" Height="18"
                                                     Foreground="#424242" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="View Participants List" FontSize="13" Foreground="#424242"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- REGION: start -->
                <Border Style="{StaticResource HelpRegion}"
                        Tag="start" MouseLeftButtonDown="Region_Click"
                        Background="{StaticResource FEUGreenBrush}"
                        Padding="16,14" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Play" Width="18" Height="18" Foreground="White"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Start Session Monitoring" FontWeight="SemiBold" Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- REGION: participants -->
                <Border Style="{StaticResource HelpRegion}"
                        Tag="participants" MouseLeftButtonDown="Region_Click"
                        Background="White">
                    <StackPanel>
                        <Border Background="{StaticResource FEUGreenBrush}" CornerRadius="9,9,0,0" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountMultiple" Width="16" Height="16"
                                                             Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Participants" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource FEUGoldBrush}" CornerRadius="10"
                                        Padding="8,2" Margin="6,0,6,0">
                                    <TextBlock Text="4/4" FontSize="11" FontWeight="Bold" Foreground="#0D3B12"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="Missing: 0" FontSize="11" Foreground="White" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <StackPanel Margin="12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton Content="Taking (2)" IsChecked="True" GroupName="HelpFilter" Margin="0,0,10,0"
                                             IsHitTestVisible="False" Focusable="False" FontSize="11"/>
                                <RadioButton Content="Done (1)" GroupName="HelpFilter" Margin="0,0,10,0"
                                             IsHitTestVisible="False" Focusable="False" FontSize="11"/>
                                <RadioButton Content="Finished (1)" GroupName="HelpFilter"
                                             IsHitTestVisible="False" Focusable="False" FontSize="11"/>
                            </StackPanel>
                            <Border Background="#F5F5F5" CornerRadius="6" Padding="8,6" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Magnify" Width="14" Height="14"
                                                             Foreground="#9E9E9E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Search…" Foreground="#9E9E9E" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- ============================================
                                 4 dummy student rows.
                                 Each row is its own clickable HelpRegion
                                 that opens the popup describing the state
                                 it demonstrates.
                                 ============================================ -->

                            <!-- Student 1 — DONE -->
                            <Border Style="{StaticResource HelpRegion}"
                                    Tag="studentDone" MouseLeftButtonDown="Region_Click"
                                    Background="#F5F5F5" Padding="10,8" Margin="0,2"
                                    BorderThickness="2" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#7C4DFF" Margin="0,0,8,0">
                                        <TextBlock Text="A" Foreground="White" FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Alice Cruz" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="completed the exam" FontSize="10" Foreground="#9E9E9E"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#E8F5E9" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CheckCircle" Width="11" Height="11"
                                                                     Foreground="#1B5E20" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <TextBlock Text="Done" FontSize="10" FontWeight="Bold" Foreground="#1B5E20" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Student 2 — RAISE HAND -->
                            <Border Style="{StaticResource HelpRegion}"
                                    Tag="studentRaiseHand" MouseLeftButtonDown="Region_Click"
                                    Background="#FFF8E1" Padding="10,8" Margin="0,2"
                                    BorderThickness="2" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#FFB300" Margin="0,0,8,0">
                                        <TextBlock Text="B" Foreground="White" FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Bob Dela Cruz" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="needs your attention" FontSize="10" Foreground="#9E9E9E"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#FFE0B2" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="HandBackRight" Width="11" Height="11"
                                                                     Foreground="#E65100" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <TextBlock Text="Raised" FontSize="10" FontWeight="Bold" Foreground="#E65100" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Student 3 — REQUEST APPROVAL -->
                            <Border Style="{StaticResource HelpRegion}"
                                    Tag="studentRequestApproval" MouseLeftButtonDown="Region_Click"
                                    Background="#FFF3E0" Padding="10,8" Margin="0,2"
                                    BorderThickness="2" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#FB8C00" Margin="0,0,8,0">
                                        <TextBlock Text="C" Foreground="White" FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Carol Estrada" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="finished — awaiting your approval" FontSize="10" Foreground="#9E9E9E"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#FFCCBC" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="HelpCircle" Width="11" Height="11"
                                                                     Foreground="#BF360C" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <TextBlock Text="Pending" FontSize="10" FontWeight="Bold" Foreground="#BF360C" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Student 4 — CONNECTED, clicking opens Student Details popup -->
                            <Border Style="{StaticResource HelpRegion}"
                                    Tag="studentDetails" MouseLeftButtonDown="Region_Click"
                                    Background="#E8F5E9" Padding="10,8" Margin="0,2"
                                    BorderThickness="2" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#7C4DFF" Margin="0,0,8,0">
                                        <TextBlock Text="D" Foreground="White" FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="dolfo" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="click to view their live status" FontSize="10" Foreground="#9E9E9E"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="10" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="CONNECTED" FontSize="10" FontWeight="Bold" Foreground="#4CAF50" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===================================================
                 RIGHT PANE — Global Log Feed (REGION: log)
                 =================================================== -->
            <Border Grid.Column="2" Style="{StaticResource HelpRegion}"
                    Tag="log" MouseLeftButtonDown="Region_Click"
                    Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="9,9,0,0" Padding="16,12" Background="White"
                            BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Global Log Feed"
                                       FontSize="15" FontWeight="Bold" Foreground="{StaticResource FEUGreenBrush}"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#E8F5E9" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                <TextBlock Text="LIVE UPDATES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource FEUGreenDarkBrush}"/>
                            </Border>
                            <TextBlock Grid.Column="3" Text="Filter:" FontSize="11" Foreground="#616161"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <!-- Filter dropdown — interactive region. Has its own
                                 Tag so click opens the filter description popup
                                 instead of the parent log-feed popup. -->
                            <Border Grid.Column="4" Style="{StaticResource HelpRegion}"
                                    Tag="filter" MouseLeftButtonDown="Region_Click"
                                    Background="White" BorderThickness="2"
                                    CornerRadius="4" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="All Entries" FontSize="11" Foreground="#424242" VerticalAlignment="Center"/>
                                    <materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14"
                                                             Foreground="#9E9E9E" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ============================================
                         Dummy log entries — one per student row above,
                         each clickable to explain that entry type.
                         ============================================ -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,10,14,10">
                        <StackPanel>
                            <Border Style="{StaticResource HelpRegion}"
                                    Tag="logEntry_completed" MouseLeftButtonDown="Region_Click"
                                    Padding="8,6" Margin="0,2" BorderThickness="2" CornerRadius="6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="10:30:00" Foreground="#9E9E9E" FontSize="11" Width="62" VerticalAlignment="Center"/>
                                    <materialDesign:PackIcon Kind="CheckCircle" Width="14" Height="14"
                                                             Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Alice Cruz completed the exam" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource HelpRegion}"
                                    Tag="logEntry_handraised" MouseLeftButtonDown="Region_Click"
                                    Padding="8,6" Margin="0,2" BorderThickness="2" CornerRadius="6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="10:32:15" Foreground="#9E9E9E" FontSize="11" Width="62" VerticalAlignment="Center"/>
                                    <materialDesign:PackIcon Kind="HandBackRight" Width="14" Height="14"
                                                             Foreground="#E65100" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Bob Dela Cruz raised their hand" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource HelpRegion}"
                                    Tag="logEntry_approval" MouseLeftButtonDown="Region_Click"
                                    Padding="8,6" Margin="0,2" BorderThickness="2" CornerRadius="6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="10:33:42" Foreground="#9E9E9E" FontSize="11" Width="62" VerticalAlignment="Center"/>
                                    <materialDesign:PackIcon Kind="HelpCircle" Width="14" Height="14"
                                                             Foreground="#BF360C" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Carol Estrada finished the exam — awaiting your approval" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource HelpRegion}"
                                    Tag="logEntry_join" MouseLeftButtonDown="Region_Click"
                                    Padding="8,6" Margin="0,2" BorderThickness="2" CornerRadius="6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="10:34:11" Foreground="#9E9E9E" FontSize="11" Width="62" VerticalAlignment="Center"/>
                                    <materialDesign:PackIcon Kind="AccountPlus" Width="14" Height="14"
                                                             Foreground="#1B5E20" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="dolfo joined the session" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="#E8F5E9" Margin="20,0,20,12" Padding="12,6" CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="TimerOutline" Width="14" Height="14"
                                         Foreground="{StaticResource FEUGreenDarkBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="Status bar — session timer and connection state appear here on the real console."
                           FontSize="11" Foreground="{StaticResource FEUGreenDarkBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Floating Close button (top-right) -->
        <Button Grid.Row="0" Content="Close Tutorial"
                Click="BtnClose_Click"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,8,28,0" Padding="14,6"
                Cursor="Hand"
                Background="{StaticResource FEUGreenBrush}" Foreground="White"
                FontWeight="SemiBold" BorderThickness="0" FontSize="12">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="cb" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="cb" Property="Background" Value="#2E7D32"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
