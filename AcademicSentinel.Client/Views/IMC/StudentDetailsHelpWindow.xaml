<Window x:Class="AcademicSentinel.Client.Views.IMC.StudentDetailsHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Student Details — Help"
        Height="680" Width="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{materialDesign:MaterialDesignFont}"
        TextElement.Foreground="#1B1B1B">

    <Window.Resources>
        <SolidColorBrush x:Key="FEUGreenBrush" Color="#1B5E20"/>
        <SolidColorBrush x:Key="DangerRedBrush" Color="#C62828"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9E9E9E"/>
    </Window.Resources>

    <Border Background="White" CornerRadius="12" MouseLeftButtonDown="Window_DragMove">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="0" Opacity="0.30" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- header -->
                <RowDefinition Height="*"/>      <!-- body -->
                <RowDefinition Height="Auto"/>   <!-- explanation strip -->
            </Grid.RowDefinitions>

            <!-- Header: "Student Details" + close ✕ -->
            <Grid Grid.Row="0" Margin="20,18,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Student Details"
                           FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Click="BtnClose_Click"
                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="cb" Background="Transparent" CornerRadius="14" Width="28" Height="28">
                                <TextBlock Text="✕" Foreground="#9E9E9E" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="cb" Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,0,20,16">
                <StackPanel>

                    <!-- Avatar + name + connected -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="#7C4DFF" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="AccountCircle" Width="36" Height="36"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="dolfo" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="to view their live status" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,1,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Ellipse Width="8" Height="8" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="CONNECTED" FontSize="10" FontWeight="Bold" Foreground="#4CAF50" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- ENVIRONMENT PROFILE -->
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="ENVIRONMENT PROFILE" FontSize="10" FontWeight="Bold"
                                       Foreground="#616161" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Environment: " FontSize="12"/>
                                <TextBlock Text="Native OS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource FEUGreenBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Remote Access: " FontSize="12"/>
                                <TextBlock Text="Inactive" FontSize="12" FontWeight="Bold" Foreground="{StaticResource FEUGreenBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- VIOLATION STATISTICS -->
                    <TextBlock Text="VIOLATION STATISTICS" FontSize="10" FontWeight="Bold"
                               Foreground="#616161" Margin="0,0,0,8"/>
                    <Border Background="#FFEBEE" CornerRadius="6" Padding="16,18" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="ALERTS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource DangerRedBrush}"/>
                            <TextBlock Text="0" FontSize="36" FontWeight="Bold" Foreground="{StaticResource DangerRedBrush}" Margin="0,2,0,10"/>
                            <TextBlock Text="RISK LEVEL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource DangerRedBrush}"/>
                            <TextBlock Text="SAFE" FontSize="42" FontWeight="Bold" Foreground="#4CAF50" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Violations Summary button (clickable — opens help popup) -->
                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="0,12" Margin="0,0,0,12"
                            Cursor="Hand" Tag="violationsSummary" MouseLeftButtonDown="Button_Click">
                        <TextBlock Text="Violations Summary" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Remove from Session button (clickable — opens help popup) -->
                    <Border Background="{StaticResource DangerRedBrush}" CornerRadius="6" Padding="0,14"
                            Cursor="Hand" Tag="removeFromSession" MouseLeftButtonDown="Button_Click">
                        <TextBlock Text="Remove from Session" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Explanation strip at the bottom -->
            <Border Grid.Row="2" Background="#FFF8E1" CornerRadius="0,0,12,12"
                    BorderBrush="#FFB300" BorderThickness="0,1,0,0" Padding="16,12">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="InformationOutline" Width="14" Height="14"
                                             Foreground="#F57F17" VerticalAlignment="Top" Margin="0,1,8,0"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#5D4037">
                        <Run Text="This panel appears in the real console when you click a connected student. Use it to spot at-risk students, inspect their environment, review violations, or remove them from the session." />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
