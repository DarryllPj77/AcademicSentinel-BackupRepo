<Window x:Class="AcademicSentinel.Client.Views.IMC.LiveSessionMonitoringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Live Session Monitoring"
        Height="820" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        FontFamily="{materialDesign:MaterialDesignFont}"
        TextElement.Foreground="#1B1B1B"
        TextElement.FontSize="13"
        Loaded="Window_Loaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Color x:Key="FEUGreen">#1B5E20</Color>
        <Color x:Key="FEUGreenLight">#2E7D32</Color>
        <Color x:Key="FEUGreenDark">#0D3B12</Color>
        <Color x:Key="FEUGold">#FFB300</Color>
        <Color x:Key="FEULightGray">#F0F2F5</Color>
        <Color x:Key="FEUSubText">#616161</Color>
        <Color x:Key="DangerRed">#D32F2F</Color>

        <SolidColorBrush x:Key="FEUGreenBrush" Color="{StaticResource FEUGreen}"/>
        <SolidColorBrush x:Key="FEUGreenLightBrush" Color="{StaticResource FEUGreenLight}"/>
        <SolidColorBrush x:Key="FEUGreenDarkBrush" Color="{StaticResource FEUGreenDark}"/>
        <SolidColorBrush x:Key="FEUGoldBrush" Color="{StaticResource FEUGold}"/>
        <SolidColorBrush x:Key="FEULightGrayBrush" Color="{StaticResource FEULightGray}"/>
        <SolidColorBrush x:Key="FEUSubTextBrush" Color="{StaticResource FEUSubText}"/>
        <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRed}"/>

        <Style x:Key="EndSessionBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DangerRedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E53935"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#B71C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource FEUGreenBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource FEUGreenLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource FEUGreenDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="#E0E0E0" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outlined variants — used by the participant-card action
             buttons (Approve/Deny finish, Allow Q&A/Deny ask, Lower
             Hand). The base PrimaryBtn / GhostBtn templates hardcode
             the Border properties, so per-button BorderBrush overrides
             don't reach the visual tree; these derived styles re-emit
             the template with a black 1px border instead. -->
        <Style x:Key="PrimaryBtnOutlined" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="Black" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource FEUGreenLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource FEUGreenDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtnOutlined" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="Black" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0,0,0,-16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,14,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="TxtRoomHeader" Text="Live Session Monitoring"
               FontSize="12" Foreground="{StaticResource FEUSubTextBrush}"
               VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" x:Name="TimerPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="TimerOutline" Width="14" Height="14" Margin="0,0,4,0" 
                                 Foreground="{StaticResource FEUSubTextBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtSessionTimer" Text="Duration: 00:00:00"
                   FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource FEUSubTextBrush}"
                   VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource FEUGreenBrush}"
                Margin="20,0,20,0" CornerRadius="12" Padding="24,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" Color="Black"/>
            </Border.Effect>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="SchoolOutline" Width="32" Height="32"
                                             Foreground="White" Margin="0,0,14,0"/>
                    <StackPanel>
                        <TextBlock Text="Instructor Monitoring Console"
                                   FontSize="17" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="(teacher side)" FontSize="11"
                                   Foreground="#A5D6A7"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <!-- Opens InstructorMonitoringHelpWindow (a safe,
                         clickable replica of this console). Non-modal
                         with Owner=this so the instructor can keep
                         glancing at the live console while reading. -->
                    <Button Content="Help"
                            Click="BtnHelp_Click"
                            Background="Transparent"
                            Foreground="White"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Margin="0,0,10,0"
                            Padding="16,10"
                            BorderBrush="#80FFFFFF"
                            BorderThickness="1.5">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="hb" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"
                                                                 Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="hb" Property="Background" Value="#22FFFFFF"/>
                                        <Setter TargetName="hb" Property="BorderBrush" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="hb" Property="Background" Value="#33FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="End Session"
                            Style="{StaticResource EndSessionBtn}"
                            Click="BtnEndSession_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6" Margin="0,0,12,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="6">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#33FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <StackPanel HorizontalAlignment="Right" Margin="0,0,12,0">
                        <TextBlock x:Name="TxtProfName" Text="Loading..."
                                   FontWeight="Bold" FontSize="14" Foreground="White"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Text="FEU Institute of Technology"
                                   FontSize="10" Foreground="#A5D6A7"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Grid Width="40" Height="40">
                        <Border x:Name="TeacherAvatarDefault" Width="40" Height="40" CornerRadius="20" Background="#7C4DFF">
                            <materialDesign:PackIcon Kind="AccountCircle" Width="26" Height="26"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Ellipse x:Name="TeacherAvatarImage" Width="40" Height="40" Visibility="Collapsed">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="TeacherAvatarBrush" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="20,20,20,0">
            <!-- Column layout:
                 0 = Left sidebar (Pause button, participants, etc.)
                     280 px initial, MinWidth=250 so the GridSplitter can't
                     collapse it past the point where the controls clip.
                 1 = GridSplitter (5 px) — draggable horizontal resizer
                     between sidebar and main feed.
                 2 = Main Global Log Feed (* — fills remaining space).
                 3 = Right Student-Details panel (Auto). -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="290"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <Border Background="White" CornerRadius="12" Padding="16,20" Margin="0,0,0,12" MinHeight="148">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05" Color="Black"/>
                    </Border.Effect>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock x:Name="TxtMonitoringState"
                                   Text="NOT ACTIVE"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#424242"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16"/>

                        <Border BorderBrush="#CFD8DC" BorderThickness="1.5" CornerRadius="16" Padding="16,6" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Grid>
                                <StackPanel x:Name="DisabledTimerPanel" Orientation="Horizontal" Visibility="Visible" HorizontalAlignment="Center">
                                    <TextBlock x:Name="CountdownDisabledIndicator"
                                               Text="No Active Countdown"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="#78909C"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel x:Name="ActiveTimerPanel" Orientation="Horizontal" Visibility="Collapsed" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="TimerOutline" Width="14" Height="14" Foreground="#E65100" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtCountdownDisplay"
                                               Text="00:07"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#E65100"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Button Style="{StaticResource GhostBtn}" Click="BtnViewParticipants_Click" HorizontalAlignment="Stretch" Padding="0,10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountMultipleOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="View Participants List" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Border>

                <Button x:Name="BtnStartMonitoring" Style="{StaticResource PrimaryBtn}"
                        Padding="16,14" Margin="0,0,0,12"
                        Click="BtnStartMonitoring_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon x:Name="StartStopIcon" Kind="Play" Width="18" Height="18" Margin="0,0,8,0"
                                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStartStopLabel" Text="Start Session Monitoring" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border Background="White" CornerRadius="12" Padding="0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Background="{StaticResource FEUGreenBrush}" CornerRadius="12,12,0,0" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="AccountMultiple" Width="16" Height="16"
                                                             Foreground="White" Margin="0,0,6,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Participants" FontSize="13" FontWeight="SemiBold"
                                               Foreground="White" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <Border Grid.Column="1" Background="{StaticResource FEUGoldBrush}"
                                        CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtParticipantCount" Text="0/0"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource FEUGreenBrush}"/>
                                </Border>

                                <TextBlock Grid.Column="2" x:Name="TxtMissingCount" Text="Missing: 0"
                                           Margin="10,0,0,0"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="White"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Participant cohort filter. RbFilterTaking is IsChecked=True
                             so the panel opens with the active-taking cohort visible
                             by default; flipping to Done shows finished students; All
                             shows both cohorts (still sorted Taking-before-Done by
                             the CollectionView's SectionSortOrder). The Content text
                             is updated in code-behind so the running counts stay
                             live without a binding-converter dance. -->
                        <Border Padding="12,10,12,4">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbFilterTaking"
                                             Content="Taking (0)"
                                             GroupName="ParticipantFilter"
                                             IsChecked="True"
                                             FontSize="11"
                                             FontWeight="SemiBold"
                                             Margin="0,0,6,0"
                                             Padding="10,4"
                                             Foreground="{StaticResource FEUGreenBrush}"
                                             Checked="RbFilterTaking_Checked"/>
                                <RadioButton x:Name="RbFilterDone"
                                             Content="Done (0)"
                                             GroupName="ParticipantFilter"
                                             FontSize="11"
                                             FontWeight="SemiBold"
                                             Margin="0,0,6,0"
                                             Padding="10,4"
                                             Foreground="#616161"
                                             Checked="RbFilterDone_Checked"/>
                                <RadioButton x:Name="RbFilterFinished"
                                             Content="Finished (0)"
                                             GroupName="ParticipantFilter"
                                             FontSize="11"
                                             FontWeight="SemiBold"
                                             Padding="10,4"
                                             Foreground="#616161"
                                             Checked="RbFilterFinished_Checked"/>
                            </StackPanel>
                        </Border>

                        <Border Padding="12,4,12,6">
                            <Border Background="#F5F5F5" CornerRadius="6" Padding="10,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="Magnify"
                                                             Width="14" Height="14" Foreground="#9E9E9E"
                                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="1" x:Name="TxtStudentSearch"
                                             BorderThickness="0" Background="Transparent"
                                             FontSize="12" VerticalContentAlignment="Center"
                                             materialDesign:HintAssist.Hint="Search students..."
                                             TextChanged="TxtStudentSearch_TextChanged"/>
                                </Grid>
                            </Border>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360" Height="340">
                            <Grid>
                                <StackPanel x:Name="EmptyParticipantsState" VerticalAlignment="Center"
                                        HorizontalAlignment="Center" Margin="0,30"
                                        Visibility="Visible">
                                    <materialDesign:PackIcon Kind="AccountMultipleOutline" Width="40" Height="40"
                                                         Foreground="#E0E0E0" HorizontalAlignment="Center"/>
                                    <TextBlock Text="No students connected" FontSize="12" Foreground="#BDBDBD"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBlock Text="Waiting for students to join..." FontSize="10" Foreground="#BDBDBD"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ItemsControl x:Name="StudentsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="row" Padding="10,10" Margin="8,2"
                                                Background="Transparent" CornerRadius="6"
                                                BorderBrush="Transparent" BorderThickness="1.5"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="ParticipantRow_Click"
                                                Tag="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,10,0">
                                                        <Border x:Name="DefaultAvatar" CornerRadius="16" Background="#7C4DFF" Visibility="{Binding HasNoProfileImageVisibility}">
                                                            <materialDesign:PackIcon Kind="AccountCircle" Width="20" Height="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Ellipse Width="32" Height="32" Visibility="{Binding HasProfileImageVisibility}">
                                                            <Ellipse.Fill>
                                                                <ImageBrush ImageSource="{Binding ProfileImageUrl}" Stretch="UniformToFill"/>
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                        <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="White" StrokeThickness="1.5"/>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Email}" FontSize="10" Foreground="{StaticResource FEUSubTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <!-- "WANTS TO FINISH" (renamed from "WANTS TO LEAVE")
                                                             surfaces the pending state of the Done flow:
                                                             student clicked Done, awaiting instructor
                                                             approval. The row stays in the Taking tab
                                                             until teacher Approve flips IsDone=true. -->
                                                        <TextBlock Text="WANTS TO FINISH"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"
                                                                   Foreground="#E65100"
                                                                   Visibility="{Binding IsLeaveRequested, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="✋ WANTS TO ASK"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"
                                                                   Foreground="#1565C0"
                                                                   Visibility="{Binding IsHandRaisePending, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="✋ HAND RAISED — Q&amp;A ACTIVE"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"
                                                                   Foreground="#E65100"
                                                                   Visibility="{Binding IsHandRaiseActive, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{Binding StatusColor}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="6,0,18,0">
                                                        <Button x:Name="BtnApproveJoin"
                                                                Content="Approve"
                                                                Style="{StaticResource PrimaryBtn}"
                                                                FontSize="10"
                                                                Padding="8,4"
                                                                Margin="0,0,6,0"
                                                                Visibility="{Binding IsJoinApprovalPending, Converter={StaticResource BoolToVis}}"
                                                                Click="BtnApproveJoin_Click"/>
                                                        <Button x:Name="BtnDenyJoin"
                                                                Content="Deny"
                                                                Style="{StaticResource GhostBtn}"
                                                                FontSize="10"
                                                                Padding="8,4"
                                                                Margin="0,0,6,0"
                                                                Visibility="{Binding IsJoinApprovalPending, Converter={StaticResource BoolToVis}}"
                                                                Click="BtnDenyJoin_Click"/>
                                                        <Button x:Name="BtnApproveLeave"
                                                                Content="Approve"
                                                                Style="{StaticResource PrimaryBtnOutlined}"
                                                                FontSize="10"
                                                                Padding="8,4"
                                                                Margin="0,0,6,0"
                                                                Visibility="{Binding IsLeaveRequested, Converter={StaticResource BoolToVis}}"
                                                                Click="BtnApproveLeave_Click"/>
                                                        <Button x:Name="BtnDenyLeave"
                                                                Content="Deny"
                                                                Style="{StaticResource GhostBtnOutlined}"
                                                                FontSize="10"
                                                                Padding="8,4"
                                                                Visibility="{Binding IsLeaveRequested, Converter={StaticResource BoolToVis}}"
                                                                Click="BtnDenyLeave_Click"/>
                                                        <Button x:Name="BtnApproveHandRaise"
                                                                Content="Allow Q&amp;A"
                                                                Style="{StaticResource PrimaryBtnOutlined}"
                                                                FontSize="10"
                                                                Padding="8,4"
                                                                Margin="0,0,6,0"
                                                                Visibility="{Binding IsHandRaisePending, Converter={StaticResource BoolToVis}}"
                                                                Click="BtnApproveHandRaise_Click"/>
                                                        <Button x:Name="BtnDenyHandRaise"
                                                                Content="Deny"
                                                                Style="{StaticResource GhostBtnOutlined}"
                                                                FontSize="10"
                                                                Padding="8,4"
                                                                Margin="0,0,6,0"
                                                                Visibility="{Binding IsHandRaisePending, Converter={StaticResource BoolToVis}}"
                                                                Click="BtnDenyHandRaise_Click"/>
                                                        <Button x:Name="BtnLowerHand"
                                                                Content="Lower Hand"
                                                                Style="{StaticResource GhostBtnOutlined}"
                                                                FontSize="10"
                                                                Padding="8,4"
                                                                Visibility="{Binding IsHandRaiseActive, Converter={StaticResource BoolToVis}}"
                                                                Click="BtnLowerHand_Click"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <materialDesign:PackIcon Kind="AlertCircle"
                                                                                 Width="16"
                                                                                 Height="16"
                                                                                 Foreground="#E53935"
                                                                                 Margin="0,0,4,0"
                                                                                 Visibility="{Binding HasViolation, Converter={StaticResource BoolToVis}}"/>
                                                        <materialDesign:PackIcon Kind="DesktopClassic"
                                                                                 Width="16"
                                                                                 Height="16"
                                                                                 Foreground="#D32F2F"
                                                                                 Visibility="{Binding HasHardwareViolation, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Draggable splitter between the sidebar (col 0) and the
                 main log feed (col 2). NO Margin: a Margin wider than
                 the column collapses the visible rectangle to zero, so
                 the bar would disappear. Solid medium-gray fill so the
                 splitter renders as a clearly visible vertical bar with
                 the standard SizeWE cursor on hover. -->
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#9E9E9E"
                          BorderBrush="#616161"
                          BorderThickness="1,0"
                          Cursor="SizeWE"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="False"/>

            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Stretch" Margin="8,0,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="CriticalAlertBanner"
                            Grid.Row="0"
                            Background="#D32F2F"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,0,0,12"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtCriticalAlertMessage"
                                       Grid.Column="0"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Text="🚨 CRITICAL SECURITY ALERT"/>
                            <Button Grid.Column="1"
                                    Content="Dismiss"
                                    Margin="10,0,0,0"
                                    Padding="10,4"
                                    Background="#33FFFFFF"
                                    Foreground="White"
                                    BorderBrush="#66FFFFFF"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Click="BtnDismissCriticalAlert_Click"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="TxtLogHeader" Text="Global Log Feed"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource FEUGreenBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border Grid.Column="1" Background="#E8F5E9" CornerRadius="10" Padding="8,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="LIVE UPDATES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource FEUGreenBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="3" Text="Filter:" FontSize="12" Foreground="{StaticResource FEUSubTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="4" x:Name="CmbLogFilter" Width="140" SelectionChanged="CmbLogFilter_SelectionChanged">
                            <ComboBoxItem Content="All Entries" IsSelected="True"/>
                            <ComboBoxItem Content="Violations Only"/>
                            <ComboBoxItem Content="Connections Only"/>
                        </ComboBox>
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <StackPanel x:Name="EmptyLogFeedState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,60" Visibility="Visible">
                                <materialDesign:PackIcon Kind="TextBoxOutline" Width="48" Height="48" Foreground="#E0E0E0" HorizontalAlignment="Center"/>
                                <TextBlock Text="No log entries yet" FontSize="14" FontWeight="SemiBold" Foreground="#BDBDBD" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                            </StackPanel>
                            <ItemsControl x:Name="LogFeedItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,10" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ClockOutline" Width="12" Height="12" Foreground="#9E9E9E" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding Timestamp}" FontSize="12" Foreground="{StaticResource FEUSubTextBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                        <!-- StudentLabel resolves to the student's FullName for
                                                             student-attributed rows (or "SYSTEM" for system rows).
                                                             Email is no longer shown here — see
                                                             LiveSessionMonitoringWindow.ResolveLogDisplayLabel. -->
                                                        <TextBlock Text="{Binding StudentLabel}" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                        <Border Background="{Binding BadgeColor}" CornerRadius="10" Padding="7,2">
                                                            <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource FEUSubTextBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border x:Name="RightDetailPanel" Grid.Column="3" Width="350" Margin="16,0,0,0" Background="White" CornerRadius="12" Padding="20" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05" Color="Black"/>
                </Border.Effect>
                <Grid x:Name="StudentDetailPanel">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Student Details" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource FEUSubTextBrush}"/>
                            <Button x:Name="BtnCloseDetailPanel"
                                    Grid.Column="1"
                                    Width="26"
                                    Height="26"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="BtnCloseDetailPanel_Click">
                                <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="{StaticResource FEUSubTextBrush}"/>
                            </Button>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="50" Height="50" CornerRadius="25" Background="#7C4DFF" Margin="0,0,12,0">
                                <materialDesign:PackIcon Kind="AccountCircle" Width="30" Height="30" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSelectedName" Text="Select a Student" FontSize="16" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtSelectedCourse" Text="to view their live status" FontSize="11" Foreground="{StaticResource FEUSubTextBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Ellipse x:Name="SelectedStatusDot" Width="7" Height="7" Fill="#9E9E9E" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtSelectedStatus" Text="WAITING" FontSize="9" FontWeight="Bold" Foreground="#9E9E9E"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#EEEEEE" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08" Color="Black"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="ENVIRONMENT PROFILE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource FEUSubTextBrush}" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Environment: " FontSize="11" Foreground="{StaticResource FEUSubTextBrush}"/>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Native OS"/>
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUsingVM}" Value="True">
                                                        <Setter Property="Text" Value="Virtual Machine"/>
                                                        <Setter Property="Foreground" Value="#D32F2F"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Remote Access: " FontSize="11" Foreground="{StaticResource FEUSubTextBrush}"/>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Inactive"/>
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRemoteDesktop}" Value="True">
                                                        <Setter Property="Text" Value="Active"/>
                                                        <Setter Property="Foreground" Value="#D32F2F"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="VIOLATION STATISTICS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource FEUSubTextBrush}" Margin="0,0,0,8" Height="15"/>
                        <!--
                            Risk panel — height is intentionally NOT fixed so the
                            wider "POSSIBLE DISHONESTY" label can wrap onto a
                            second line in the narrow Student Details column
                            without being clipped. FontSize is dropped to 22 and
                            TextWrapping is enabled on the risk label so the
                            wording fits cleanly across the available width.
                            ALERTS keeps its larger 36pt readout — only the
                            multi-word risk label needed the layout tweak.
                        -->
                        <Border Background="#FFEBEE" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="ALERTS" FontSize="10" FontWeight="Bold" Foreground="#D32F2F"/>
                                <TextBlock x:Name="TxtAlertCount" Text="0" FontSize="36" FontWeight="Bold" Foreground="#D32F2F"/>
                                <TextBlock Text="RISK LEVEL" FontSize="10" FontWeight="Bold" Foreground="#D32F2F" Margin="0,4,0,0"/>
                                <TextBlock x:Name="TxtRiskLevel"
                                           Text="SAFE"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#1B5E20"
                                           TextWrapping="Wrap"
                                           LineHeight="26"
                                           LineStackingStrategy="BlockLineHeight"/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="RecentActivityList" Margin="0,0,0,20"/>

                        <Button Content="Violations Summary"
                                Style="{StaticResource GhostBtn}"
                                HorizontalAlignment="Stretch"
                                Padding="0,10"
                                Margin="0,0,0,10"
                                Click="BtnViewSummary_Click"/>

                        <Button Content="Remove from Session" Style="{StaticResource EndSessionBtn}" HorizontalAlignment="Stretch" Padding="0,12" Click="BtnRemoveFromSession_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        
    </Grid>
</Window>