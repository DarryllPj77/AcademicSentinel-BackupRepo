<Window x:Class="AcademicSentinel.Client.Views.IMC.MonitoringHelpInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Help"
        Height="560" Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.Resources>
        <SolidColorBrush x:Key="FEUGreenBrush" Color="#1B5E20"/>
        <SolidColorBrush x:Key="FEUGreenDarkBrush" Color="#0D3B12"/>
        <SolidColorBrush x:Key="FEUGoldBrush" Color="#FFB300"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#616161"/>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource FEUGoldBrush}"/>
            <Setter Property="Margin" Value="0,16,0,4"/>
        </Style>

        <Style x:Key="SectionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1B1B1B"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="12" MouseLeftButtonDown="Window_DragMove">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="0" Opacity="0.30" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Green header band, matches the live console's title bar -->
            <Border Grid.Row="0" Background="{StaticResource FEUGreenBrush}" CornerRadius="12,12,0,0" Padding="22,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="8" Background="#33FFFFFF" Margin="0,0,12,0">
                            <materialDesign:PackIcon x:Name="IcoRegion" Kind="HelpCircleOutline"
                                                     Width="22" Height="22" Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TUTORIAL" FontSize="9" FontWeight="Bold" Foreground="#A5D6A7"/>
                            <TextBlock x:Name="TxtTitle" Text="Region title"
                                       FontSize="17" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Click="BtnClose_Click"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            VerticalAlignment="Center"
                            Padding="6">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="cb" Background="Transparent" CornerRadius="14" Width="28" Height="28">
                                    <TextBlock Text="✕" Foreground="White" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="cb" Property="Background" Value="#33FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Scrollable body with three labelled sections -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,18,26,18">
                <StackPanel>
                    <TextBlock Text="DESCRIPTION" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtDescription" Style="{StaticResource SectionText}"/>

                    <TextBlock Text="PURPOSE" Style="{StaticResource SectionLabel}"/>
                    <TextBlock x:Name="TxtPurpose" Style="{StaticResource SectionText}"/>

                    <TextBlock Text="SCENARIO" Style="{StaticResource SectionLabel}"/>
                    <TextBlock x:Name="TxtScenario" Style="{StaticResource SectionText}"/>

                    <Border Background="#FFF8E1" CornerRadius="6" Padding="10,8" Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="14" Height="14"
                                                     Foreground="#F57F17" VerticalAlignment="Top" Margin="0,1,8,0"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#5D4037">
                                <Run Text="This is a replica."/>
                                <Run Text=" Nothing on the tutorial screen starts, pauses, or ends a real session."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer with Got it button -->
            <Border Grid.Row="2" Background="#FAFAFA" CornerRadius="0,0,12,12"
                    BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="18,12">
                <Button Content="Got it"
                        Click="BtnClose_Click"
                        HorizontalAlignment="Right"
                        Background="{StaticResource FEUGreenBrush}" Foreground="White"
                        FontWeight="SemiBold" BorderThickness="0"
                        Padding="18,8" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="gb" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="gb" Property="Background" Value="#2E7D32"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
