<Window x:Class="AcademicSentinel.Client.Views.IMC.SessionArchiveDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Session Archive"
        Height="680"
        Width="1080"
        WindowStartupLocation="CenterOwner"
        Background="#F6F8FA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1B5E20"/>
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E4E7EB"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>

        <Style x:Key="MaterialDesignOutlinedButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#101B5E20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="18" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ClipboardTextClockOutline" Width="22" Height="22" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="Session Archive" FontSize="22" FontWeight="Bold" Foreground="#1B1B1B"/>
                </StackPanel>

                <!--
                    Header action row: Analytic Mode toggle next to Back.
                    Active state repaints the background green in
                    code-behind so the instructor immediately sees which
                    view they're in.
                -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnArchiveAnalyticMode"
                            Click="BtnArchiveAnalyticMode_Click"
                            Background="#1976D2"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            FontSize="12"
                            Padding="14,8"
                            Margin="0,0,8,0"
                            Cursor="Hand"
                            ToolTip="Toggle session-wide analytics dashboard">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartBar" Width="16" Height="16"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtArchiveAnalyticMode" Text="Analytic Mode"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Content="Back"
                            Click="BtnBack_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.0*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#FAFBFC" CornerRadius="8" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" Padding="10,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="18" Height="18" Foreground="#8C8C8C" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 x:Name="TxtSearch"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 FontSize="13"
                                 TextChanged="TxtSearch_TextChanged"
                                 materialDesign:HintAssist.Hint="Search by name or email"/>
                    </Grid>
                </Border>

                <ComboBox Grid.Column="2"
                          x:Name="CmbRiskLevel"
                          SelectionChanged="CmbRiskLevel_SelectionChanged"
                          VerticalContentAlignment="Center">
                    <ComboBoxItem Content="All" IsSelected="True"/>
                    <ComboBoxItem Content="SAFE"/>
                    <ComboBoxItem Content="SUSPICIOUS"/>
                    <ComboBoxItem Content="POSSIBLE DISHONESTY"/>
                </ComboBox>
            </Grid>
        </Border>

        <!--
            Row 4 hosts BOTH the standard data-grid card AND the
            analytics dashboard. Both children occupy the same Grid
            slot — Visibility is flipped by BtnArchiveAnalyticMode_Click.
            The search box + risk-level dropdown above stay visible
            either way (they just become no-ops while analytics is on).
        -->
        <Grid Grid.Row="4">
        <Border x:Name="ArchiveDataGridCard" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1">
            <DataGrid x:Name="ArchiveDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      AlternatingRowBackground="#FAFBFC">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Participant Name" Binding="{Binding Name}" Width="1.8*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2.2*"/>
                    <DataGridTextColumn Header="Violations" Binding="{Binding ViolationCount}" Width="0.9*"/>
                    <DataGridTextColumn Header="Risk Level" Binding="{Binding RiskLevel}" Width="1.1*"/>
                    <!-- Connection-quality column. Computed server-side from
                         MonitoringEvents — "Clean Connection" / "Reconnected"
                         / "Disconnected". Cell background tinted via style
                         trigger so disconnects stand out at a glance. -->
                    <DataGridTextColumn Header="Connection" Binding="{Binding ConnectionQuality}" Width="1.2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="6,2"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="Clean Connection">
                                        <Setter Property="Foreground" Value="#1B5E20"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="Reconnected">
                                        <Setter Property="Foreground" Value="#E65100"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="Disconnected">
                                        <Setter Property="Foreground" Value="#C62828"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Actions" Width="1.8*" MinWidth="240">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="View Logs"
                                            Click="BtnViewLogs_Click"
                                            Tag="{Binding}"
                                            Padding="10,5"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                    <Button x:Name="BtnExportPdf"
                                            Content="Export PDF"
                                            Click="BtnExportPdf_Click"
                                            Tag="{Binding}"
                                            Padding="10,5"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!--
            Analytics dashboard. Sits on top of row 4 with Visibility
            Collapsed by default. LoadArchiveAnalytics() populates the
            two ItemsControls with grouped MetricAnalyticItem rows;
            Count/Max drive the ProgressBar widths so they are scaled
            against the total participant count.
        -->
        <Border x:Name="ArchiveAnalyticsPanel"
                Background="{StaticResource CardBrush}"
                CornerRadius="12"
                Padding="20"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="1"
                Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Session Overview"
                               FontWeight="Bold" FontSize="16"
                               Foreground="#1B1B1B" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtArchiveTotalViolations"
                               Text="0 violation(s) recorded."
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="#D32F2F"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Risk Level Distribution"
                               FontWeight="SemiBold" FontSize="13"
                               Foreground="#424242" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="ArchiveRiskAnalyticsControl" Margin="0,0,0,20">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Category}"
                                               FontWeight="SemiBold" FontSize="12"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Category}"/>
                                    <Border Grid.Column="1" Background="#EEEEEE"
                                            CornerRadius="3" Height="20" Margin="10,0">
                                        <ProgressBar Value="{Binding Count, Mode=OneWay}"
                                                     Maximum="{Binding Max, Mode=OneWay}"
                                                     Foreground="{Binding BarBrush}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Height="20"/>
                                    </Border>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Count}"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold" FontSize="13"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Connection Quality Distribution"
                               FontWeight="SemiBold" FontSize="13"
                               Foreground="#424242" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="ArchiveConnectionAnalyticsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Category}"
                                               FontWeight="SemiBold" FontSize="12"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Category}"/>
                                    <Border Grid.Column="1" Background="#EEEEEE"
                                            CornerRadius="3" Height="20" Margin="10,0">
                                        <ProgressBar Value="{Binding Count, Mode=OneWay}"
                                                     Maximum="{Binding Max, Mode=OneWay}"
                                                     Foreground="{Binding BarBrush}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Height="20"/>
                                    </Border>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Count}"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold" FontSize="13"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="TxtArchiveAnalyticsEmpty"
                               Text="No participants to analyze for this session."
                               FontSize="12" FontStyle="Italic"
                               Foreground="#9E9E9E"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        </Grid>
    </Grid>
</Window>
