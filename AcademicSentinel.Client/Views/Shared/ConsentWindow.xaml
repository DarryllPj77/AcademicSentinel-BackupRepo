<Window x:Class="AcademicSentinel.Client.Views.Shared.ConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Privacy Notice &amp; Consent"
        Icon="/Assets/FourCUDAIcon256.ico"
        Height="520" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Privacy Notice &amp; Consent"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="22">
                <Run FontWeight="Bold">What Academic Sentinel Monitors:</Run>
                <LineBreak/>
                • Active application/window switching during IMC sessions only
                <LineBreak/>
                • Canvas LMS activity (open, closed, returned)
                <LineBreak/>
                • Session participation status
                <LineBreak/><LineBreak/>
                <Run FontWeight="Bold">What Academic Sentinel Does NOT Collect:</Run>
                <LineBreak/>
                • Screenshots or screen recordings
                <LineBreak/>
                • Personal files or documents
                <LineBreak/>
                • Keystrokes or passwords
                <LineBreak/>
                • Activity outside of active IMC sessions
                <LineBreak/><LineBreak/>
                <Run FontWeight="Bold">Data Usage:</Run>
                <LineBreak/>
                Collected data is used solely for academic research purposes
                as part of a thesis study. All data is confidential and will
                not be shared with third parties.
                <LineBreak/><LineBreak/>
                <Run FontWeight="Bold">Voluntary Participation:</Run>
                <LineBreak/>
                Your participation is voluntary. You may discontinue use at
                any time by closing the application.
                <LineBreak/><LineBreak/>
                By clicking "I Agree", you consent to the monitoring
                described above during active IMC sessions.
            </TextBlock>
        </ScrollViewer>

        <CheckBox Grid.Row="2" x:Name="chkAgree"
                  Content="I have read and agree to the Privacy Notice"
                  Margin="0,15,0,10" FontSize="13"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="btnDecline" Content="Decline"
                    Width="100" Height="35" Margin="0,0,10,0"
                    Click="BtnDecline_Click"/>
            <Button x:Name="btnAgree" Content="I Agree"
                    Width="100" Height="35"
                    IsEnabled="{Binding ElementName=chkAgree, Path=IsChecked}"
                    Click="BtnAgree_Click"/>
        </StackPanel>
    </Grid>
</Window>