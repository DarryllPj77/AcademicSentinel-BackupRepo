<Window x:Class="AcademicSentinel.Client.Views.Shared.EmailVerificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Verify Email - AcademicSentinel"
        Height="460" Width="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{materialDesign:MaterialDesignFont}"
        ResizeMode="NoResize"
        MouseDown="Window_MouseDown">
    <Border Background="White" CornerRadius="12" Padding="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.18" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <Button x:Name="BtnClose" DockPanel.Dock="Right"
                        Content="✕" Width="28" Height="28"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#9E9E9E" Cursor="Hand"
                        Click="BtnClose_Click"/>
                <TextBlock Text="Verify Your Email"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#1B5E20" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock Text="We sent a 6-digit verification code to your institutional email. Enter it below to finish creating your account."
                       FontSize="12" Foreground="#616161"
                       TextWrapping="Wrap" Margin="0,0,0,16"/>

            <TextBlock Text="Email" FontSize="11" FontWeight="SemiBold" Foreground="#616161" Margin="0,0,0,4"/>
            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Margin="0,0,0,14" Background="#FAFAFA">
                <TextBox x:Name="TxtEmail" Padding="10,8" FontSize="13"
                         BorderThickness="0" Background="Transparent"
                         IsReadOnly="True"/>
            </Border>

            <TextBlock Text="Verification Code" FontSize="11" FontWeight="SemiBold" Foreground="#616161" Margin="0,0,0,4"/>
            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Margin="0,0,0,16">
                <TextBox x:Name="TxtCode" Padding="10,10"
                         FontSize="20" FontWeight="Bold"
                         TextAlignment="Center"
                         MaxLength="6"
                         BorderThickness="0" Background="Transparent"
                         materialDesign:HintAssist.Hint="000000"/>
            </Border>

            <Button x:Name="BtnVerify"
                    Content="Verify Code"
                    Height="42"
                    FontSize="14" FontWeight="SemiBold"
                    Background="#1B5E20" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    IsDefault="True"
                    Margin="0,0,0,12"
                    Click="BtnVerify_Click"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TxtStatus"
                           FontSize="11" Foreground="#616161"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="BtnResend"
                        Content="Resend code"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#1565C0" FontSize="12" FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="BtnResend_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
