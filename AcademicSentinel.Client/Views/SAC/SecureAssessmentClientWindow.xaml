<Window x:Class="AcademicSentinel.Client.Views.SAC.SecureAssessmentClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Secure Assessment Client - FourCUDA"
        Height="720" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{materialDesign:MaterialDesignFont}"
        TextElement.Foreground="#1B1B1B"
        TextElement.FontSize="14">

    <Window.Resources>
        <SolidColorBrush x:Key="FEUGreenBrush" Color="#1B5E20"/>
        <SolidColorBrush x:Key="FEUGreenLightBrush" Color="#2E7D32"/>
        <SolidColorBrush x:Key="FEUGreenDarkBrush" Color="#0D3B12"/>
        <SolidColorBrush x:Key="FEUGoldBrush" Color="#FFB300"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Connection-lost banner. Toggled programmatically by the
             TeacherDisconnected hub event. Sits as an overlay on row 1 so it
             appears below the header without changing row indices used by
             the rest of the window. -->
        <Border x:Name="TeacherDisconnectedBanner" Grid.Row="1"
                Background="#FFF8E1" BorderBrush="#FFB300" BorderThickness="0,0,0,2"
                Padding="20,10" VerticalAlignment="Top"
                Visibility="Collapsed" Panel.ZIndex="100">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="WifiAlert" Width="22" Height="22"
                                         Foreground="#E65100" VerticalAlignment="Center"
                                         Margin="0,0,10,0"/>
                <TextBlock x:Name="TxtTeacherDisconnectedBanner"
                           Text="Connection to Instructor Lost. Reconnecting..."
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#E65100" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ======================== TOP HEADER BAR ======================== -->
        <Border Grid.Row="0" Background="#B3FFFFFF" Padding="24,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Grid.Column="0" Kind="ShieldCheckOutline" Width="24" Height="24"
                                             Foreground="#1B5E20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" x:Name="TxtHeaderSessionClock"
                               Text=""
                               FontSize="16" FontWeight="Bold"
                               Foreground="#1B5E20" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnHeaderExpand" Visibility="Collapsed" Margin="0,0,10,0"
                            Padding="10,6" FontSize="13" Cursor="Hand"
                            Content="□" Click="BtnExpandCompact_Click"/>

                    <!-- The only exit button. Visibility controlled strictly
                         by the state machine in UpdateUIForPhase(): visible
                         during Active, hidden in Pre-Exam / Paused / Compact. -->
                    <Button x:Name="BtnDone"
                            Content="Done"
                            Padding="12,7"
                            MinWidth="120"
                            FontSize="16"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Background="#1B5E20"
                            Foreground="White"
                            BorderThickness="0"
                            Visibility="Collapsed"
                            Click="BtnDone_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================== MAIN CONTENT ======================== -->
        <Grid x:Name="SessionContentGrid" Grid.Row="1" Margin="30,24,30,24">
            <Border x:Name="FullSessionPanel" Background="#B3FFFFFF" CornerRadius="16" Padding="32">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.06" Color="Black"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Monitoring Status Indicator -->
                    <Border Grid.Row="0" CornerRadius="8" Padding="14,10" Margin="0,0,0,20">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FFEBEE"/>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="MonitorDot" Width="10" Height="10" Margin="0,0,10,0">
                                <Ellipse.Fill>
                                    <SolidColorBrush x:Name="MonitorDotBrush" Color="#D32F2F"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock x:Name="TxtMonitoringStatus"
                                       Text="Monitoring Active - You cannot leave during the session"
                                       FontSize="18" FontWeight="Bold" Foreground="#C62828"/>
                        </StackPanel>
                    </Border>

                    <!-- Course Room Title -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <TextBlock Text="Course Room :" FontSize="13" FontWeight="Medium" Foreground="#616161" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtCourseRoom"
                                   Text="2TSYS2526 - MATH - TN310-2"
                                   FontSize="18" FontWeight="Bold" Foreground="#1B5E20"/>
                    </StackPanel>

                    <!-- Student Information -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,24"/>

                    <!-- Detection Reports -->
                    <TextBlock Grid.Row="3" Text="Detection Reports :" FontSize="14" FontWeight="SemiBold"
                               Foreground="#1B1B1B" Margin="0,0,0,10"/>

                    <Border Grid.Row="4" Background="#B3FAFAFA" CornerRadius="10"
                            BorderBrush="#E0E0E0" BorderThickness="1" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DetectionReportsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="14,10" Margin="0,0,0,1"
                                                BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="AlertOutline"
                                                                         Width="16" Height="16"
                                                                         Foreground="#FF9800"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding}" FontSize="13" Foreground="#616161"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="CompactPanel"
                    Visibility="Collapsed"
                    Background="#B3FFFFFF"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8,6"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <StackPanel VerticalAlignment="Center">
                    <Border Background="#B3F5F5F5"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="6,2"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,4">
                        <TextBlock x:Name="TxtCompactMonitoringStatus"
                                   Text="Monitoring: Waiting"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#616161"/>
                    </Border>

                    <TextBlock x:Name="TxtCompactLeavePermission"
                               Text="Leave Permission: Allowed"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#2E7D32"
                               Margin="2,0,0,0"
                               TextWrapping="NoWrap"
                               TextTrimming="None"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================== BOTTOM-LEFT COUNTDOWN BAR ======================== -->
        <!-- Per QA decision: countdown text lives at bottom-left of the SAC
             softlock UI for every scenario (initial countdown, resume,
             session timer). Visible in both full and compact modes. -->
        <Border Grid.Row="2" Background="#B3FFFFFF" Padding="20,8"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <TextBlock x:Name="TxtBottomCountdown"
                       Text=""
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="#1B5E20"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"/>
        </Border>

        <Grid x:Name="WaitingScreenOverlay" Grid.RowSpan="3" Background="#E6000000" Visibility="Collapsed" Panel.ZIndex="999">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="20" Margin="0,0,0,20"/>
                <TextBlock x:Name="WaitingScreenText" Foreground="White" FontSize="18" Text="Waiting for instructor approval..."/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
