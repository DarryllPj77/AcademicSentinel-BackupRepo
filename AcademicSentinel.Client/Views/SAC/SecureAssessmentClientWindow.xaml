<Window x:Class="AcademicSentinel.Client.Views.SAC.SecureAssessmentClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Secure Assessment Client - FourCUDA"
        Height="720" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{materialDesign:MaterialDesignFont}"
        TextElement.Foreground="#1B1B1B"
        TextElement.FontSize="14">

    <Window.Resources>
        <SolidColorBrush x:Key="FEUGreenBrush" Color="#1B5E20"/>
        <SolidColorBrush x:Key="FEUGreenLightBrush" Color="#2E7D32"/>
        <SolidColorBrush x:Key="FEUGreenDarkBrush" Color="#0D3B12"/>
        <SolidColorBrush x:Key="FEUGoldBrush" Color="#FFB300"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Connection-lost banner. Toggled programmatically by the
             TeacherDisconnected hub event. Sits as an overlay on row 1 so it
             appears below the header without changing row indices used by
             the rest of the window. -->
        <Border x:Name="TeacherDisconnectedBanner" Grid.Row="1"
                Background="#FFF8E1" BorderBrush="#FFB300" BorderThickness="0,0,0,2"
                Padding="20,10" VerticalAlignment="Top"
                Visibility="Collapsed" Panel.ZIndex="100">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="WifiAlert" Width="22" Height="22"
                                         Foreground="#E65100" VerticalAlignment="Center"
                                         Margin="0,0,10,0"/>
                <TextBlock x:Name="TxtTeacherDisconnectedBanner"
                           Text="Connection to Instructor Lost. Reconnecting..."
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#E65100" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ======================== TOP HEADER BAR ======================== -->
        <Border Grid.Row="0" Background="#B3FFFFFF" Padding="24,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Grid.Column="0" Kind="ShieldCheckOutline" Width="24" Height="24"
                                             Foreground="#1B5E20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" x:Name="TxtHeaderSessionClock"
                               Text=""
                               FontSize="16" FontWeight="Bold"
                               Foreground="#1B5E20" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Minimize-to-compact button. Visible in full mode
                         (default), Collapsed in compact mode — opposite
                         of BtnHeaderExpand. SwitchToCompactMode hides
                         it and shows BtnHeaderExpand; BtnExpandCompact_Click
                         does the inverse. Click routes to BtnMinimize_Click
                         which calls SwitchToCompactMode() directly — the
                         existing OnStateChanged minimize-trap would have
                         the same end result but a more visible flicker. -->
                    <Button x:Name="BtnMinimize"
                            Width="36" Height="32"
                            Padding="0"
                            Margin="0,0,8,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Minimize to compact softlock"
                            Click="BtnMinimize_Click">
                        <materialDesign:PackIcon Kind="WindowMinimize"
                                                 Width="18" Height="18"
                                                 Foreground="#616161"/>
                    </Button>

                    <Button x:Name="BtnHeaderExpand" Visibility="Collapsed" Margin="0,0,10,0"
                            Padding="10,6" FontSize="13" Cursor="Hand"
                            Content="□" Click="BtnExpandCompact_Click"/>

                    <!-- Raise Hand request — temporary Q&A access via the
                         meeting app (Teams / Zoom / Meet). Visibility &
                         content are driven by UpdateUIForPhase() in tandem
                         with _handRaiseState. Same compact-only visibility
                         rule as BtnDone. -->
                    <Button x:Name="BtnRaiseHand"
                            Content="Raise Hand"
                            Padding="12,7"
                            MinWidth="120"
                            FontSize="16"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Background="#1565C0"
                            Foreground="White"
                            BorderThickness="0"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Click="BtnRaiseHand_Click"/>

                    <!-- The only exit button. Visibility controlled strictly
                         by the state machine in UpdateUIForPhase(): visible
                         during Active, hidden in Pre-Exam / Paused / Compact. -->
                    <Button x:Name="BtnDone"
                            Content="Done"
                            Padding="12,7"
                            MinWidth="120"
                            FontSize="16"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Background="#1B5E20"
                            Foreground="White"
                            BorderThickness="0"
                            Visibility="Collapsed"
                            Click="BtnDone_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================== MAIN CONTENT ======================== -->
        <!-- Vertical margin zeroed (was "30,24,30,24") so the middle
             content sits flush against the header strip and the
             bottom countdown bar. The 24 px on top and bottom
             previously rendered as visible transparent bands above
             and below the FullSessionPanel card; horizontal 30 px
             is kept as intentional breathing room from the window
             edges. -->
        <Grid x:Name="SessionContentGrid" Grid.Row="1" Margin="30,0,30,0">
            <!-- CornerRadius and DropShadow stripped so FullSessionPanel
                 no longer reads as a floating card with separate
                 elevation — it now visually continues the frosted
                 strip flowing down from the header to the bottom
                 countdown bar. Background and internal Padding are
                 unchanged. -->
            <Border x:Name="FullSessionPanel" Background="#B3FFFFFF" CornerRadius="0" Padding="32">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Monitoring Status Indicator -->
                    <Border Grid.Row="0" CornerRadius="8" Padding="14,10" Margin="0,0,0,20">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FFEBEE"/>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="MonitorDot" Width="10" Height="10" Margin="0,0,10,0">
                                <Ellipse.Fill>
                                    <SolidColorBrush x:Name="MonitorDotBrush" Color="#D32F2F"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock x:Name="TxtMonitoringStatus"
                                       Text="Monitoring Active - You cannot leave during the session"
                                       FontSize="18" FontWeight="Bold" Foreground="#C62828"/>
                        </StackPanel>
                    </Border>

                    <!-- Course Room Title -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <TextBlock Text="Course Room :" FontSize="13" FontWeight="Medium" Foreground="#616161" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtCourseRoom"
                                   Text="2TSYS2526 - MATH - TN310-2"
                                   FontSize="18" FontWeight="Bold" Foreground="#1B5E20"/>
                    </StackPanel>

                    <!-- Row 2 intentionally left empty. The former
                         "Student Information" placeholder was deleted
                         (it had no content but its 24 px bottom margin
                         created a visible empty band between Course
                         Room and Detection Reports). The Auto row
                         collapses to 0 height with no child, so we
                         don't have to renumber the rows below. -->

                    <!-- Detection Reports -->
                    <TextBlock Grid.Row="3" Text="Detection Reports :" FontSize="14" FontWeight="SemiBold"
                               Foreground="#1B1B1B" Margin="0,0,0,10"/>

                    <Border Grid.Row="4" Background="#B3FAFAFA" CornerRadius="10"
                            BorderBrush="#E0E0E0" BorderThickness="1" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DetectionReportsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="14,10" Margin="0,0,0,1"
                                                BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="AlertOutline"
                                                                         Width="16" Height="16"
                                                                         Foreground="#FF9800"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding}" FontSize="13" Foreground="#616161"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- Compact-mode status band. Decorations (border / corner
                 radius) intentionally stripped so the panel reads as a
                 continuous frosted-glass extension of the header strip
                 above and the countdown bar below — not as a separate
                 floating card. The background is left at #B3FFFFFF so
                 it matches both neighbours; with the outer Margin
                 zeroed in SwitchToCompactMode there is no longer a
                 transparent gap between them. -->
            <Border x:Name="CompactPanel"
                    Visibility="Collapsed"
                    Background="#B3FFFFFF"
                    BorderThickness="0"
                    CornerRadius="0"
                    Padding="20,8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <StackPanel VerticalAlignment="Center">
                    <Border Background="#B3F5F5F5"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="6,2"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,4">
                        <TextBlock x:Name="TxtCompactMonitoringStatus"
                                   Text="Monitoring: Waiting"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#616161"/>
                    </Border>

                    <TextBlock x:Name="TxtCompactLeavePermission"
                               Text="Leave Permission: Allowed"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#2E7D32"
                               Margin="2,0,0,0"
                               TextWrapping="NoWrap"
                               TextTrimming="None"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================== BOTTOM-LEFT COUNTDOWN BAR ======================== -->
        <!-- Per QA decision: countdown text lives at bottom-left of the SAC
             softlock UI for every scenario (initial countdown, resume,
             session timer). Visible in both full and compact modes. -->
        <Border Grid.Row="2" Background="#B3FFFFFF" Padding="20,8"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <TextBlock x:Name="TxtBottomCountdown"
                       Text=""
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="#1B5E20"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"/>
        </Border>

        <Grid x:Name="WaitingScreenOverlay" Grid.RowSpan="3" Background="#E6000000" Visibility="Collapsed" Panel.ZIndex="999">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="20" Margin="0,0,0,20"/>
                <TextBlock x:Name="WaitingScreenText" Foreground="White" FontSize="18" Text="Waiting for instructor approval..."/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
