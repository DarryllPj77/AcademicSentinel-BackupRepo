# AcademicSentinel.Server — environment variable template
#
# Copy this file to `.env` (gitignored) for local development, or set
# the same variables in your DigitalOcean droplet's systemd unit /
# docker-compose / app spec.
#
# IMPORTANT: NEVER commit the real .env. Only this .env.example with
# placeholder values lives in source control.
#
# .NET Configuration converts the "__" separator in env var names to
# the ":" separator used in C# IConfiguration access, e.g.
# Email__Password is read as Email:Password.


# ============================================================
# DATABASE — PostgreSQL connection
# ============================================================
# Render-style URI; the server parses postgres:// and postgresql://
# automatically via Program.cs. For local dev you can also leave this
# unset and the appsettings.json fallback will be used.
# DATABASE_URL=postgres://user:password@host:5432/academicsentinel


# ============================================================
# JWT — token signing
# ============================================================
JWT_KEY=replace-with-a-strong-random-base64-string
JWT_ISSUER=AcademicSentinel
JWT_AUDIENCE=AcademicSentinel


# ============================================================
# EMAIL — Gmail SMTP transactional sender
# ============================================================
# Visible sender. Recipient inbox will display the friendly name.
Email__From=AcademicSentinel <AcademicSentinel4@gmail.com>

# SMTP login. For Gmail this is the same address as Email__From.
Email__Username=AcademicSentinel4@gmail.com

# IMPORTANT: this must be a Gmail *App Password*, NOT the normal
# account password. Generate one at:
#   https://myaccount.google.com/apppasswords
# (2-Step Verification must be enabled on AcademicSentinel4@gmail.com
# before the App Passwords page is available.)
Email__Password=YOUR_GMAIL_APP_PASSWORD

Email__Host=smtp.gmail.com
Email__Port=587
Email__EnableSsl=true


# ============================================================
# CORS — comma-separated allowed origins for the WPF client / web
# ============================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000


# ============================================================
# CLOUDINARY — image storage (REQUIRED in Production)
# ============================================================
# Local-disk storage is used when this is empty (dev only).
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
